# Auto detect text files
* text=auto eol=lf

# Force LF for shell scripts
*.sh text eol=lf
*.ps1 text eol=crlf

# Force CRLF for Windows-specific files
*.sln text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

# Force LF for build config
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
