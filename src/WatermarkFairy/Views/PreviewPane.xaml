<UserControl x:Class="WatermarkFairy.Views.PreviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:WatermarkFairy.Views"
             xmlns:vm="clr-namespace:WatermarkFairy.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PreviewViewModel}"
             d:DesignHeight="450" d:DesignWidth="600">

    <Border Background="#FFFFFF">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 状态条 -->
            <Border Grid.Row="0" Background="#F5F5F5" Padding="8,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="#555" FontSize="11" />
                    <ProgressBar Grid.Column="1"
                                 Width="80" Height="3"
                                 Minimum="0" Maximum="1"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsRendering, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>

            <!-- 预览图 / 空状态 -->
            <Grid Grid.Row="1">
                <Image Source="{Binding PreviewImage}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding PreviewImage, Converter={StaticResource NullToVis}}" />

                <TextBlock Text="预览区（M1-7）&#xA;选图片后实时显示水印效果"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="#CCC"
                           FontSize="14"
                           Visibility="{Binding PreviewImage, Converter={StaticResource NullToVisInvert}}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>