<Window x:Class="WatermarkFairy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WatermarkFairy"
        xmlns:vm="clr-namespace:WatermarkFairy.ViewModels"
        xmlns:models="clr-namespace:WatermarkFairy.Models"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Watermark Fairy · 水印精灵"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#555" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏（M3-2 扩展：Cloud UI） -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左：标题 -->
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="Watermark Fairy"
                               FontSize="18" FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <TextBlock Text=" · 水印精灵"
                               FontSize="14" Foreground="#666"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0" />
                    <TextBlock Text=" · M3 阶段"
                               FontSize="12" Foreground="#999"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0" />
                </StackPanel>

                <!-- 中：Cloud 登录 / 用户信息 -->
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 未登录：登录表单 -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsCloudAuthenticated, Converter={StaticResource BoolToVisInvert}}">
                        <TextBlock Text="邮箱" VerticalAlignment="Center" Margin="4,0" />
                        <TextBox Text="{Binding LoginEmail, UpdateSourceTrigger=PropertyChanged}"
                                 Width="140" />
                        <TextBlock Text="密码" VerticalAlignment="Center" Margin="8,0,4,0" />
                        <PasswordBox x:Name="LoginPasswordBox" Width="100"
                                     PasswordChanged="OnLoginPasswordChanged" />
                        <Button Content="登录"
                                Command="{Binding LoginCommand}"
                                Margin="8,0,0,0" />
                    </StackPanel>

                    <!-- 已登录：用户信息 + 登出 -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsCloudAuthenticated, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="已登录：" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CloudUserEmail}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="登出"
                                Command="{Binding LogoutCommand}"
                                Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 右：Cloud 同步按钮 -->
                <StackPanel Orientation="Horizontal" Grid.Column="2">
                    <Button Content="上传模板"
                            Command="{Binding UploadCurrentCommand}"
                            ToolTip="上传当前 Config 为云端模板" />
                    <Button Content="刷新列表"
                            Command="{Binding RefreshCloudCommand}"
                            ToolTip="从云端刷新模板列表" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容：3 列布局 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="300" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- 左：控制面板 -->
            <Border Grid.Column="0" Background="#FAFAFA" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="水印配置" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <TextBlock Text="文字" Style="{StaticResource LabelStyle}" />
                        <TextBox Text="{Binding Config.Layers[0].Text, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="字体" Style="{StaticResource LabelStyle}" />
                        <ComboBox IsEditable="True"
                                  ItemsSource="{Binding SystemFonts}"
                                  Text="{Binding Config.Layers[0].FontFamily}" />

                        <TextBlock Text="字号" Style="{StaticResource LabelStyle}" />
                        <Slider Minimum="8" Maximum="120"
                                Value="{Binding Config.Layers[0].FontSize}"
                                TickFrequency="2" IsSnapToTickEnabled="False" />

                        <TextBlock Text="颜色 (16 预设色 + 高级 hex)" Style="{StaticResource LabelStyle}" />
                        <!-- v0.1.1 16 预设色色板 -->
                        <ItemsControl ItemsSource="{Binding PresetColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="28" Height="28" Margin="3"
                                            Background="{Binding}"
                                            BorderBrush="#BBB"
                                            ToolTip="{Binding}"
                                            Command="{Binding DataContext.PickPresetColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Hex 高级输入 -->
                        <TextBox Text="{Binding Config.Layers[0].Color, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="位置" Style="{StaticResource LabelStyle}" />
                        <ComboBox x:Name="PositionCombo"
                                  SelectedItem="{Binding Config.Layers[0].Position}" />

                        <TextBlock Text="边距 (像素)" Style="{StaticResource LabelStyle}" />
                        <Slider Minimum="0" Maximum="200"
                                Value="{Binding Config.Layers[0].Margin}"
                                TickFrequency="5" IsSnapToTickEnabled="False" />

                        <TextBlock Text="透明度" Style="{StaticResource LabelStyle}" />
                        <Slider Minimum="0" Maximum="1"
                                Value="{Binding Config.Layers[0].Opacity}"
                                TickFrequency="0.05" IsSnapToTickEnabled="False" />

                        <Separator Margin="0,16,0,8" />

                        <TextBlock Text="输出格式" Style="{StaticResource LabelStyle}" />
                        <ComboBox x:Name="FormatCombo"
                                  SelectedItem="{Binding Config.Output.Format}" />

                        <TextBlock Text="输出质量" Style="{StaticResource LabelStyle}" />
                        <Slider Minimum="50" Maximum="100"
                                Value="{Binding Config.Output.Quality}"
                                TickFrequency="5" IsSnapToTickEnabled="False" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 中：预览区（v0.1.1 auto preview + Image 控件） -->
            <Border Grid.Column="1" Background="#FFFFFF">
                <Grid>
                    <!-- 无文件时的提示 -->
                    <TextBlock Text="未选择图片 · v0.1.1 auto preview"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#CCC"
                               FontSize="14"
                               Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisInvert}}" />
                    <!-- 预览图像 -->
                    <Image Source="{Binding PreviewImageSource}"
                           Stretch="Uniform"
                           Margin="8" />
                </Grid>
            </Border>

            <!-- 右：文件列表 + 进度 -->
            <Border Grid.Column="2" Background="#F8F8F8" Padding="12">
                <DockPanel LastChildFill="True">
                    <!-- 操作按钮 -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Vertical">
                        <Button Content="添加图片"
                                Click="OnAddFiles"
                                IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}"
                                Margin="0,0,0,4" />
                        <Button Content="添加文件夹"
                                Click="OnAddFolder"
                                IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}"
                                Margin="0,0,0,4" />
                        <Button Content="清空"
                                Click="OnClearFiles"
                                IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}"
                                Margin="0,0,0,8" />
                        <!-- v0.1.1 手动预览按钮（auto-preview 失败时兜底） -->
                        <Button Content="刷新预览"
                                Command="{Binding GeneratePreviewCommand}"
                                IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}"
                                Margin="0,0,0,8" />
                        <Separator Margin="0,4,0,8" />
                        <!-- v0.1.1 输出目录 -->
                        <TextBlock Text="输出目录" FontSize="12" Foreground="#555" Margin="0,0,0,2" />
                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right"
                                    Content="选择..."
                                    Command="{Binding PickOutputFolderCommand}"
                                    Padding="6,2" />
                            <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="True" />
                        </DockPanel>
                        <!-- v0.1.1 导出按钮 -->
                        <Button Content="导出水印"
                                Command="{Binding ExportWatermarkCommand}"
                                Background="#4CAF50"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Padding="12,8"
                                Margin="0,4,0,8" />
                    </StackPanel>

                    <!-- 进度条 -->
                    <ProgressBar DockPanel.Dock="Top"
                                 Height="6"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent}"
                                 Margin="0,0,0,8"
                                 Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" />

                    <!-- 文件列表 -->
                    <ListBox ItemsSource="{Binding FileList}"
                             x:Name="FileListBox"
                             SelectionMode="Extended"
                             AllowDrop="True"
                             DragOver="OnFileListDragOver"
                             Drop="OnFileListDrop" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- 状态栏（M3-2 扩展：Cloud 状态） -->
        <Border Grid.Row="2" Background="#F0F0F0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="#555" />
                <TextBlock Grid.Column="1" Text="{Binding CloudStatusText}"
                           Foreground="#666" Margin="0,0,12,0" />
                <TextBlock Grid.Column="2" Foreground="#888">
                    <Run Text="{Binding FileCount, Mode=OneWay}" />
                    <Run Text=" 个文件" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>