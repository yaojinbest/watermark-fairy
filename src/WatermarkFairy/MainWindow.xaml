<Window x:Class="WatermarkFairy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WatermarkFairy"
        xmlns:vm="clr-namespace:WatermarkFairy.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Watermark Fairy · 水印精灵"
        Height="640" Width="960"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Watermark Fairy" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text=" · 水印精灵" FontSize="14" Foreground="#666" VerticalAlignment="Center" Margin="4,0,0,0" />
                <TextBlock Text=" · M1-2 阶段" FontSize="12" Foreground="#999" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>
        </Border>

        <!-- 主区域：占位（M1-6 完整化） -->
        <Border Grid.Row="1" Background="#FFFFFF">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Watermark Fairy"
                           FontSize="32" FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="v0.1.0 Internal Alpha"
                           FontSize="14" Foreground="#999"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                <TextBlock Text="{Binding StatusText}"
                           FontSize="12" Foreground="#666"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />
            </StackPanel>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="12,4">
            <TextBlock Text="{Binding StatusText}" Foreground="#555" />
        </Border>
    </Grid>
</Window>
