<Window x:Class="WatermarkFairy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WatermarkFairy"
        xmlns:vm="clr-namespace:WatermarkFairy.ViewModels"
        xmlns:models="clr-namespace:WatermarkFairy.Models"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Watermark Fairy · 水印精灵"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏（v0.2 精简：仅标题） -->
        <Border Grid.Row="0" Background="{DynamicResource BackgroundSecondaryBrush}" Padding="12,8">
            <TextBlock Text="Watermark Fairy · 水印精灵"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />
        </Border>

        <!-- 主内容：3 列布局 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="300" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- 左：控制面板 -->
            <Border Grid.Column="0" Background="{DynamicResource BackgroundPrimaryBrush}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="水印配置" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="文字" Style="{StaticResource LabelStyle}" />
                        <!-- v0.2.1 多行输入（owner 6 意见）：支持换行符 \n，长文本友好 -->
                        <TextBox Text="{Binding Config.Layers[0].Text, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="60"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="字体" Style="{StaticResource LabelStyle}" />
                        <ComboBox IsEditable="True"
                                  ItemsSource="{Binding SystemFonts}"
                                  Text="{Binding Config.Layers[0].FontFamily}" />

                        <TextBlock Text="字号" Style="{StaticResource LabelStyle}" />
                        <Slider Minimum="8" Maximum="120"
                                Value="{Binding Config.Layers[0].FontSize}"
                                TickFrequency="2" IsSnapToTickEnabled="False" />

                        <TextBlock Text="颜色 (16 预设色 + 高级 hex)" Style="{StaticResource LabelStyle}" />
                        <!-- v0.1.1 16 预设色色板 -->
                        <ItemsControl ItemsSource="{Binding PresetColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- v0.2.1 4×4 紧凑布局（owner 5 意见） -->
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 22×22 + Margin=2 (旧 28×28 + Margin=3) -->
                                    <Button Width="22" Height="22" Margin="2"
                                            Background="{Binding}"
                                            BorderBrush="{DynamicResource BorderBrushKey}"
                                            ToolTip="{Binding}"
                                            Command="{Binding DataContext.PickPresetColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Hex 高级输入 -->
                        <TextBox Text="{Binding Config.Layers[0].Color, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="位置" Style="{StaticResource LabelStyle}" />
                        <ComboBox x:Name="PositionCombo"
                                  SelectedItem="{Binding Config.Layers[0].Position}" />

                        <TextBlock Text="边距 (像素)" Style="{StaticResource LabelStyle}" />
                        <Slider Minimum="0" Maximum="200"
                                Value="{Binding Config.Layers[0].Margin}"
                                TickFrequency="5" IsSnapToTickEnabled="False" />

                        <TextBlock Text="透明度" Style="{StaticResource LabelStyle}" />
                        <Slider Minimum="0" Maximum="1"
                                Value="{Binding Config.Layers[0].Opacity}"
                                TickFrequency="0.05" IsSnapToTickEnabled="False" />

                        <Separator Margin="0,16,0,8" />

                        <TextBlock Text="输出格式" Style="{StaticResource LabelStyle}" />
                        <ComboBox x:Name="FormatCombo"
                                  SelectedItem="{Binding Config.Output.Format}" />

                        <TextBlock Text="输出质量" Style="{StaticResource LabelStyle}" />
                        <Slider Minimum="50" Maximum="100"
                                Value="{Binding Config.Output.Quality}"
                                TickFrequency="5" IsSnapToTickEnabled="False" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 中：预览区（v0.1.1 auto preview + Image 控件） -->
            <Border Grid.Column="1" Background="{DynamicResource BackgroundPrimaryBrush}">
                <Grid>
                    <!-- 无文件时的提示 -->
                    <TextBlock Text="未选择图片 · v0.1.1 auto preview"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextDisabledBrush}"
                               FontSize="14"
                               Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisInvert}}" />
                    <!-- 预览图像 -->
                    <Image Source="{Binding PreviewImageSource}"
                           Stretch="Uniform"
                           Margin="8" />
                </Grid>
            </Border>

            <!-- 右：文件列表 + 进度 -->
            <Border Grid.Column="2" Background="{DynamicResource BackgroundSecondaryBrush}" Padding="12">
                <DockPanel LastChildFill="True">
                    <!-- 操作按钮 -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Vertical">
                        <Button Content="添加图片"
                                Click="OnAddFiles"
                                IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}"
                                Margin="0,0,0,4" />
                        <Button Content="添加文件夹"
                                Click="OnAddFolder"
                                IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}"
                                Margin="0,0,0,4" />
                        <Button Content="清空"
                                Click="OnClearFiles"
                                IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}"
                                Margin="0,0,0,8" />
                        <Separator Margin="0,4,0,8" />
                        <!-- v0.1.1 输出目录 -->
                        <TextBlock Text="输出目录" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,2" />
                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right"
                                    Content="选择..."
                                    Command="{Binding PickOutputFolderCommand}"
                                    Padding="6,2" />
                            <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="True" />
                        </DockPanel>
                        <!-- v0.1.1 导出按钮 -->
                        <Button Content="导出水印"
                                Command="{Binding ExportWatermarkCommand}"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Padding="12,8"
                                Margin="0,4,0,8" />
                    </StackPanel>

                    <!-- 进度条 -->
                    <ProgressBar DockPanel.Dock="Top"
                                 Height="6"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent}"
                                 Margin="0,0,0,8"
                                 Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" />

                    <!-- 文件列表（单选：预览只显示一张图，多选 UX 反而困惑）-->
                    <ListBox ItemsSource="{Binding FileList}"
                             x:Name="FileListBox"
                             SelectionMode="Single"
                             AllowDrop="True"
                             DragOver="OnFileListDragOver"
                             Drop="OnFileListDrop"
                             SelectionChanged="OnFileListSelectionChanged" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- 状态栏（v0.2 精简） -->
        <Border Grid.Row="2" Background="{DynamicResource BackgroundSecondaryBrush}" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="{Binding FileCount, Mode=OneWay}" />
                    <Run Text=" 个文件" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>