<Window x:Class="WatermarkFairy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WatermarkFairy"
        xmlns:vm="clr-namespace:WatermarkFairy.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Watermark Fairy · 水印精灵"
        Height="640" Width="960"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="4" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Watermark Fairy" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text=" · 水印精灵" FontSize="14" Foreground="#666" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>
        </Border>

        <!-- 主区域：左控制 + 右预览 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：控制面板 -->
            <Border Grid.Column="0" Background="#FAFAFA" Padding="16">
                <StackPanel>
                    <TextBlock Text="水印配置" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <TextBlock Text="文字" Margin="0,8,0,4" />
                    <TextBox Text="{Binding Config.Text, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="字体" Margin="0,8,0,4" />
                    <TextBox Text="{Binding Config.FontFamily}" />

                    <TextBlock Text="字号" Margin="0,8,0,4" />
                    <Slider Minimum="8" Maximum="120" Value="{Binding Config.FontSize}"
                            TickFrequency="4" IsSnapToTickEnabled="False" />

                    <TextBlock Text="颜色 (Hex)" Margin="0,8,0,4" />
                    <TextBox Text="{Binding Config.Color}" />

                    <TextBlock Text="位置" Margin="0,8,0,4" />
                    <ComboBox SelectedItem="{Binding Config.Position}" />

                    <TextBlock Text="透明度" Margin="0,8,0,4" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding Config.Opacity}"
                            TickFrequency="0.1" IsSnapToTickEnabled="False" />

                    <Button Content="选择图片" Margin="0,16,0,0" Click="OnSelectImage" />
                    <Button Content="导出" Margin="0,4,0,0" Click="OnExport" />
                </StackPanel>
            </Border>

            <!-- 右侧：预览区 -->
            <Border Grid.Column="1" Background="#FFFFFF">
                <TextBlock Text="预览区（M1 实现）"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#999" FontSize="16" />
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="12,4">
            <TextBlock Text="{Binding StatusText}" Foreground="#555" />
        </Border>
    </Grid>
</Window>
