<Window x:Class="WatermarkFairy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WatermarkFairy"
        xmlns:vm="clr-namespace:WatermarkFairy.ViewModels"
        xmlns:models="clr-namespace:WatermarkFairy.Models"
        xmlns:controls="clr-namespace:WatermarkFairy.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Watermark Fairy · 水印精灵"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <!-- v0.3.3.6 Ctrl+Z 撤回快捷键 -->
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏（v0.2 精简：仅标题） -->
        <Border Grid.Row="0" Background="{DynamicResource BackgroundSecondaryBrush}" Padding="12,8">
            <TextBlock Text="Watermark Fairy · 水印精灵"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />
        </Border>

        <!-- 主内容：3 列布局 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="300" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- 左：控制面板 -->
            <Border Grid.Column="0" Background="{DynamicResource BackgroundPrimaryBrush}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="水印配置" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,8" />

                        <!-- v0.3.3.5 裁剪模式挪到水印文字上面（owner 11:49） -->
                        <TextBlock Text="裁剪模式" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,4" />
                        <CheckBox IsChecked="{Binding IsCropEnabled}"
                                  Content="启用裁剪（拖框任意大小）"
                                  Margin="0,0,0,4"
                                  FontWeight="SemiBold" />
                        <Button Content="重置当前裁剪"
                                Command="{Binding ClearCropCommand}"
                                Margin="0,0,0,8" />

                        <TextBlock Text="文字" Style="{StaticResource LabelStyle}" />
                        <!-- v0.2.1 多行输入（owner 6 意见）：支持换行符 \n，长文本友好 -->
                        <TextBox Text="{Binding Config.Layers[0].Text, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="60"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock Text="字体" Style="{StaticResource LabelStyle}" />
                        <ComboBox IsEditable="True"
                                  ItemsSource="{Binding SystemFonts}"
                                  Text="{Binding Config.Layers[0].FontFamily}"
                                  Background="#444444"
                                  Foreground="White" />

                        <TextBlock Text="字号" Style="{StaticResource LabelStyle}" />
                        <Slider Minimum="8" Maximum="120"
                                Value="{Binding Config.Layers[0].FontSize}"
                                TickFrequency="2" IsSnapToTickEnabled="False"
                                Background="#444444" />

                        <TextBlock Text="颜色 (16 预设色 + 高级 hex)" Style="{StaticResource LabelStyle}" />
                        <!-- v0.1.1 16 预设色色板 -->
                        <!-- v0.3.3.2 fill color 16 预设色 8×2 紧凑 + 可折叠（Expander） -->
                        <Expander Header="16 预设色" IsExpanded="True" Margin="0,0,0,4">
                            <ItemsControl ItemsSource="{Binding PresetColors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- v0.3.3 8×2 紧凑布局（owner v0.3.3 反馈，节省纵向空间） -->
                                        <UniformGrid Columns="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- v0.3.3 14×14 + Margin=1 (旧 22×22 + Margin=2) -->
                                        <Button Width="14" Height="14" Margin="1"
                                                Background="{Binding}"
                                                BorderBrush="{DynamicResource BorderBrushKey}"
                                                ToolTip="{Binding}"
                                                Command="{Binding DataContext.PickPresetColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <!-- Hex 高级输入 -->
                        <TextBox Text="{Binding Config.Layers[0].Color, UpdateSourceTrigger=PropertyChanged}"
         VerticalScrollBarVisibility="Disabled"
         HorizontalScrollBarVisibility="Disabled" />

                        <!-- v0.3.1 描边 -->
                        <TextBlock Text="描边" Style="{StaticResource LabelStyle}" />
                        <CheckBox IsChecked="{Binding Config.Layers[0].Stroke}"
                                  Content="启用描边"
                                  Margin="0,0,0,4" />
                        <!-- v0.3.3.2 描边 16 预设色（8×2 紧凑 + 可折叠，仅 Stroke=true 时显示） -->
                        <Expander Header="16 描边预设色" IsExpanded="True" Margin="0,0,0,4"
                                  Visibility="{Binding Config.Layers[0].Stroke, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding PresetColors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="14" Height="14" Margin="1"
                                                Background="{Binding}"
                                                BorderBrush="{DynamicResource BorderBrushKey}"
                                                ToolTip="{Binding}"
                                                Command="{Binding DataContext.PickPresetStrokeColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <TextBox Text="{Binding Config.Layers[0].StrokeColor, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding Config.Layers[0].Stroke}"
                                 VerticalScrollBarVisibility="Disabled"
                                 HorizontalScrollBarVisibility="Disabled" />
                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Config.Layers[0].StrokeWidth, StringFormat=F1}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Margin="4,0,0,0" />
                            <Slider Minimum="0" Maximum="8"
                                    Value="{Binding Config.Layers[0].StrokeWidth}"
                                    TickFrequency="0.5" IsSnapToTickEnabled="False"
                                    Background="#444444"
                                    IsEnabled="{Binding Config.Layers[0].Stroke}" />
                        </DockPanel>

                        <!-- v0.3.1 背景色 -->
                        <TextBlock Text="背景色" Style="{StaticResource LabelStyle}" />
                        <CheckBox IsChecked="{Binding Config.Layers[0].HasBackground}"
                                  Content="启用背景色"
                                  Margin="0,0,0,4" />
                        <!-- v0.3.3.2 背景色 16 预设色（8×2 紧凑 + 可折叠，仅 HasBackground=true 时显示） -->
                        <Expander Header="16 背景预设色" IsExpanded="True" Margin="0,0,0,4"
                                  Visibility="{Binding Config.Layers[0].HasBackground, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding PresetColors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="14" Height="14" Margin="1"
                                                Background="{Binding}"
                                                BorderBrush="{DynamicResource BorderBrushKey}"
                                                ToolTip="{Binding}"
                                                Command="{Binding DataContext.PickPresetBackgroundColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <TextBox Text="{Binding Config.Layers[0].BackgroundColor, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding Config.Layers[0].HasBackground}"
                                 VerticalScrollBarVisibility="Disabled"
                                 HorizontalScrollBarVisibility="Disabled" />
                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Config.Layers[0].BackgroundOpacity, StringFormat={}{0:P0}}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Margin="4,0,0,0" />
                            <Slider Minimum="0" Maximum="1"
                                    Value="{Binding Config.Layers[0].BackgroundOpacity}"
                                    TickFrequency="0.05" IsSnapToTickEnabled="False"
                                    Background="#444444"
                                    IsEnabled="{Binding Config.Layers[0].HasBackground}" />
                        </DockPanel>

                        <TextBlock Text="位置" Style="{StaticResource LabelStyle}" />
                        <ComboBox x:Name="PositionCombo"
                                  SelectedItem="{Binding Config.Layers[0].Position}"
                                  Background="#444444"
                                  Foreground="White" />

                        <TextBlock Text="透明度" Style="{StaticResource LabelStyle}" />
                        <Slider Minimum="0" Maximum="1"
                                Value="{Binding Config.Layers[0].Opacity}"
                                TickFrequency="0.05" IsSnapToTickEnabled="False"
                                Background="#444444" />

                        <Separator Margin="0,16,0,8" />

                        <TextBlock Text="输出格式" Style="{StaticResource LabelStyle}" />
                        <ComboBox x:Name="FormatCombo"
                                  SelectedItem="{Binding Config.Output.Format}"
                                  Background="#444444"
                                  Foreground="White" />

                        <TextBlock Text="输出质量" Style="{StaticResource LabelStyle}" />
                        <Slider Minimum="50" Maximum="100"
                                Value="{Binding Config.Output.Quality}"
                                TickFrequency="5" IsSnapToTickEnabled="False"
                                Background="#444444" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 中：预览区（v0.2.2 Viewbox + 原图 Grid + Canvas 拖拽浮层） -->
            <Border Grid.Column="1" Background="{DynamicResource BackgroundPrimaryBrush}">
                <Grid>
                    <!-- 无文件时的提示 -->
                    <TextBlock Text="未选择图片 · v0.2.2 drag overlay"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextDisabledBrush}"
                               FontSize="14"
                               Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisInvert}}" />

                    <!-- v0.2.2 预览 + 拖拽浮层：Viewbox 自动缩放,内部 Grid 用原始像素坐标 -->
                    <Viewbox Stretch="Uniform" StretchDirection="Both">
                        <Grid Width="{Binding OriginalImageWidth}" Height="{Binding OriginalImageHeight}">
                            <!-- 原图（不烘焙水印，由 Canvas 浮层渲染） -->
                            <Image Source="{Binding PreviewImageSource}" Stretch="Fill" IsHitTestVisible="False" />
                            <!-- 水印拖拽浮层 -->
                            <Canvas x:Name="WatermarkCanvas" Background="Transparent">
                                <Border x:Name="WatermarkBorder"
                                        Padding="6"
                                        Canvas.Left="{Binding WatermarkLeft}"
                                        Canvas.Top="{Binding WatermarkTop}"
                                        Cursor="SizeAll"
                                        MouseDown="OnWatermarkMouseDown"
                                        MouseMove="OnWatermarkMouseMove"
                                        MouseUp="OnWatermarkMouseUp">
                                    <!-- v0.3.3.3 背景色：Border 矩形填充（保留 v0.3.3.1 实现） -->
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Config.Layers[0].HasBackground}" Value="True">
                                                    <Setter Property="Background" Value="{Binding PreviewBackgroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <!-- v0.3.3.3 描边：用自定义 OutlinedText 控件实现真正的字符描边（不是 Border 矩形边框） -->
                                    <controls:OutlinedText
                                        Text="{Binding Config.Layers[0].Text}"
                                        FontFamily="{Binding Config.Layers[0].FontFamily}"
                                        FontSize="{Binding Config.Layers[0].FontSize}"
                                        Fill="{Binding Config.Layers[0].Color}"
                                        Opacity="{Binding Config.Layers[0].Opacity}">
                                        <controls:OutlinedText.Style>
                                            <Style TargetType="controls:OutlinedText">
                                                <Setter Property="Stroke" Value="{x:Null}" />
                                                <Setter Property="StrokeThickness" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Config.Layers[0].Stroke}" Value="True">
                                                        <Setter Property="Stroke" Value="{Binding Config.Layers[0].StrokeColor}" />
                                                        <Setter Property="StrokeThickness" Value="{Binding Config.Layers[0].StrokeWidth}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:OutlinedText.Style>
                                    </controls:OutlinedText>
                                </Border>
                            </Canvas>

                            <!-- v0.3.2 裁剪浮层（Canvas 与 WatermarkCanvas 同坐标，左面板 IsCropEnabled 开关） -->
                            <Canvas x:Name="CropCanvas" Background="Transparent"
                                    Visibility="{Binding IsCropEnabled, Converter={StaticResource BoolToVis}}"
                                    MouseDown="OnCropMouseDown"
                                    MouseMove="OnCropMouseMove"
                                    MouseUp="OnCropMouseUp">
                                <Border x:Name="ExistingCropBorder"
                                        BorderBrush="#007ACC"
                                        BorderThickness="2"
                                        Background="#1A007ACC"
                                        Canvas.Left="{Binding CurrentCropRect.X, FallbackValue=0}"
                                        Canvas.Top="{Binding CurrentCropRect.Y, FallbackValue=0}"
                                        Width="{Binding CurrentCropRect.Width, FallbackValue=0}"
                                        Height="{Binding CurrentCropRect.Height, FallbackValue=0}"
                                        IsHitTestVisible="False" />
                            </Canvas>
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>

            <!-- 右：文件列表 + 进度 -->
            <Border Grid.Column="2" Background="{DynamicResource BackgroundSecondaryBrush}" Padding="12">
                <DockPanel LastChildFill="True">
                    <!-- 操作按钮 -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Vertical">
                        <Button Content="添加图片"
                                Click="OnAddFiles"
                                IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}"
                                Margin="0,0,0,4" />
                        <Button Content="添加文件夹"
                                Click="OnAddFolder"
                                IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}"
                                Margin="0,0,0,4" />
                        <!-- v0.3.3.6 撤回按钮（快捷键 Ctrl+Z） -->
                        <Button Content="撤回 (Ctrl+Z)"
                                Command="{Binding UndoCommand}"
                                Margin="0,0,0,4" />
                        <Button Content="清空"
                                Click="OnClearFiles"
                                IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}"
                                Margin="0,0,0,8" />
                        <Separator Margin="0,4,0,8" />
                        <!-- v0.1.1 输出目录 -->
                        <TextBlock Text="输出目录" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,2" />
                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right"
                                    Content="选择..."
                                    Command="{Binding PickOutputFolderCommand}"
                                    Padding="6,2" />
                            <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="True" />
                        </DockPanel>
                        <!-- v0.1.1 导出按钮 -->
                        <Button Content="导出水印"
                                Command="{Binding ExportWatermarkCommand}"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Padding="12,8"
                                Margin="0,4,0,8" />
                    </StackPanel>

                    <!-- 进度条 -->
                    <ProgressBar DockPanel.Dock="Top"
                                 Height="6"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent}"
                                 Margin="0,0,0,8"
                                 Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" />

                    <!-- 文件列表（单选：预览只显示一张图，多选 UX 反而困惑）v0.3.0 + 右键删除 + Delete 键 -->
                    <ListBox ItemsSource="{Binding FileList}"
                             x:Name="FileListBox"
                             SelectionMode="Single"
                             AllowDrop="True"
                             DragOver="OnFileListDragOver"
                             Drop="OnFileListDrop"
                             SelectionChanged="OnFileListSelectionChanged"
                             KeyDown="OnFileListKeyDown">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="删除" Click="OnRemoveFile" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 状态栏（v0.2 精简） -->
        <Border Grid.Row="2" Background="{DynamicResource BackgroundSecondaryBrush}" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="{Binding FileCount, Mode=OneWay}" />
                    <Run Text=" 个文件" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>